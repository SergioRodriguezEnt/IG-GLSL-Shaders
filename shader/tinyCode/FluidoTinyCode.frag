precision highp float;uniform vec2 u_resolution;uniform float u_time;void main(){vec4 q;vec2 c=vec2(0);float s,f;for(float j=0.;j<1.;j+=.5){s=u_time/3.+j;f=fract(s)/8.;q=(gl_FragCoord.xyxy+vec4(0,0,1,0))/u_resolution.y*2.;for(float i=0.;i<24.;i++)for(float l=1.;l<7.;l++)q-=cos(l+vec2(11,22)).xyxy*cos(cos(l+vec2(0,11))*mat2(q)*(l+l)+u_time+l).xxyy/l*f;for(float o=1.;o<5.;o++)c+=min(f,.125-f)*sin(q.xz*o*o+q.yw*o+s)/o;}s=abs(c.x);gl_FragColor=vec4(smoothstep(.03,.05,vec3(c.x,s*.5,-c.x))+(abs(c.y)-s)*30.,1);}